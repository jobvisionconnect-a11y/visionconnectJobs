# VisionConnect Jobs: set these in Render -> Environment (or a local .env file)

# Supabase -> Project Settings -> API
SUPABASE_URL=https://your-project.supabase.co
# SERVICE ROLE key. Server side only. Never put it in browser code or commit it.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Long random string, e.g. run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change_me
NODE_ENV=production
PORT=3000

# Resumes: "supabase" (private Storage bucket "resumes", default) or "local" (development only)
STORAGE_DRIVER=supabase

# ---- Keep the free hosting awake (automatic on Render) ----
# Render sets RENDER_EXTERNAL_URL itself, so nothing to do there. On other hosts set your public address:
# KEEP_ALIVE_URL=https://your-site.example.com
# KEEP_ALIVE=off            # to disable

# ---- Emails (optional but needed for "Forgot password") ----
# Brevo: free 300 emails/day, verify one sender address, no domain needed. https://www.brevo.com
MAIL_PROVIDER=brevo
BREVO_API_KEY=
MAIL_FROM="VisionConnect Jobs <your-verified-sender@example.com>"
# Public address, used in email links (Render: filled automatically if you leave it empty)
APP_URL=

# ---- Shown on the Contact and Privacy pages ----
CONTACT_EMAIL=
CONTACT_PHONE=

# ---- Only if your site has NO https (for example a plain IP address) ----
# Login cookies are "secure" in production, so without HTTPS login would silently fail.
# COOKIE_SECURE=false
