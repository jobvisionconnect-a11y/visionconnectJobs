<%- include('../partials/head') %>
<div class="narrow">
    <h1>Log in</h1>
    <%- include('../partials/flash') %>
    <%- include('../partials/errors') %>
    <form class="form" method="post" action="/auth/login" novalidate>
        <%- csrfField() %>
        <%- include('../partials/field', { f: { name: 'email', label: 'Email address', type: 'email', value: formData.email, required: true, autocomplete: 'email', inputmode: 'email' } }) %>
        <%- include('../partials/field', { f: { name: 'password', label: 'Password', type: 'password', required: true, autocomplete: 'current-password' } }) %>
        <button class="btn btn-lg" type="submit">Log in</button>
    </form>
    <p class="mt"><a href="/auth/forgot">Forgot your password?</a></p>
    <p>New to VisionConnect? <a href="/auth/register">Create a free account</a></p>
</div>
<%- include('../partials/foot') %>
