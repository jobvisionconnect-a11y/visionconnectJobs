<% const keys = Object.keys(errors || {}); if (keys.length) { %>
<div class="notice notice-error error-summary" role="alert" tabindex="-1" data-autofocus aria-labelledby="error-summary-title">
    <span class="ico" aria-hidden="true">⚠</span>
    <div>
        <h2 id="error-summary-title"><%= keys.length === 1 ? 'There is 1 problem' : 'There are ' + keys.length + ' problems' %> to fix</h2>
        <ul>
            <% keys.forEach(function (k) { %>
                <li><% if (k === 'form') { %><%= errors[k] %><% } else { %><a href="#<%= k %>"><%= errors[k] %></a><% } %></li>
            <% }) %>
        </ul>
    </div>
</div>
<% } %>
