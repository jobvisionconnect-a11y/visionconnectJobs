<% const hasErrs = errors && Object.keys(errors).length > 0; %>
<% if (success) { %>
    <div class="notice notice-success" role="status" <%- hasErrs ? '' : 'data-autofocus' %>>
        <span class="ico" aria-hidden="true">✓</span>
        <div><p><strong>Done.</strong> <%= success %></p></div>
    </div>
<% } %>
<% if (error) { %>
    <div class="notice notice-error" role="alert" <%- (hasErrs || success) ? '' : 'data-autofocus' %>>
        <span class="ico" aria-hidden="true">⚠</span>
        <div><p><strong>Problem.</strong> <%= error %></p></div>
    </div>
<% } %>
