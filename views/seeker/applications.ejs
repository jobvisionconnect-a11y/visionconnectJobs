<%- include('../partials/head') %>
<h1>My applications</h1>
<%- include('../partials/flash') %>
<% if (!applications.length) { %>
    <div class="card card-empty">
        <h2>No applications yet</h2>
        <p>When you apply for a job, you can follow it here.</p>
        <a class="btn" href="/jobs">Find jobs</a>
    </div>
<% } else { %>
    <p class="muted"><%= h.plural(applications.length, 'application') %>, newest first.</p>
    <% applications.forEach(function (a) { %>
        <article class="card" aria-labelledby="app-<%= a.id %>">
            <div class="row-between">
                <h2 class="card-title" id="app-<%= a.id %>"><a href="/jobs/<%= a.jobs.id %>"><%= a.jobs.title %></a></h2>
                <%- include('../partials/status-badge', { status: a.status }) %>
            </div>
            <ul class="meta">
                <li><span class="k">Company:</span> <%= a.jobs.company %></li>
                <% if (a.jobs.location) { %><li><span class="k">Location:</span> <%= a.jobs.location %></li><% } %>
                <li><span class="k">Applied:</span> <%= h.fmtDate(a.applied_at) %></li>
                <li><span class="k">Method:</span> <%= a.is_quick_apply ? 'Quick apply' : 'Cover letter' %></li>
            </ul>
            <p><%= h.STATUS[a.status].help %></p>
            <% if (a.status === 'applied') { %>
            <form method="post" action="/seeker/applications/<%= a.id %>/withdraw" data-confirm="Withdraw your application for <%= a.jobs.title %>? You can apply again later.">
                <%- csrfField() %>
                <button class="btn btn-ghost-danger btn-sm" type="submit">Withdraw application<span class="sr-only"> for <%= a.jobs.title %></span></button>
            </form>
            <% } %>
        </article>
    <% }) %>
<% } %>
<%- include('../partials/foot') %>
